import time  
import streamlit as st
# pahle hour ko ghanto me nikal kar integer me convert kar lete hai
hour = int(time.strftime('%H'))
#Ab isme Coditional operators ka use karte hai

if(hour>=4 and hour <12):
  st.success("Good Morning")
elif(hour>=12 and hour <17):
  st.success("Good Afternoon")
elif(hour>=17 and  hour <21):
  st.success("Good Evening")
else:
  st.success("Good night")
